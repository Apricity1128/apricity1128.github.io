---
/**
 * 项目页 /projects
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import projectsData from '../data/projects.json';

const items = [...projectsData.items].sort(
  (a, b) => Number(b.featured) - Number(a.featured) || Number(b.year) - Number(a.year)
);
---

<BaseLayout title="项目" description="我做过的项目">
  <div class="container-page pt-10 sm:pt-14">
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-fg">项目</h1>
      <p class="mt-1.5 text-sm leading-relaxed text-fg-muted">{projectsData.intro}</p>
    </header>

    <div class="space-y-3">
      {
        items.map((item) => (
          <div class="card card-hover p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-[1.05rem] font-semibold tracking-tight text-fg">
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-underline"
                  >
                    {item.name}
                  </a>
                ) : (
                  item.name
                )}
              </h2>
              <span class="text-xs tabular-nums text-fg-subtle">{item.year}</span>
            </div>

            <p class="mt-2 text-sm leading-relaxed text-fg-muted">{item.description}</p>

            <div class="mt-3.5 flex flex-wrap items-center gap-x-2 gap-y-2">
              {item.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}

              {item.repo && (
                <a
                  href={item.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ml-auto flex items-center gap-1.5 text-xs text-fg-subtle transition-colors hover:text-accent"
                >
                  <Icon name="github" size={13} />
                  源码
                </a>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BaseLayout>
