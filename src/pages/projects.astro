---
/**
 * 项目页 /projects
 *
 * 风格参考 Astro Theme Pure（arthals.ink 使用的主题）：
 * 按分区组织，每个分区下面是一个 2 列卡片网格。
 * 项目数据在 src/data/projects.json 里改。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../data/site.mjs';
import projectsData from '../data/projects.json';

/** 过滤掉没有项目的分区，避免页面出现空标题 */
const sections = (projectsData.sections ?? []).filter((s) => (s.items ?? []).length > 0);

const total = sections.reduce((sum, s) => sum + s.items.length, 0);

const github = SITE.socials.find((s) => s.icon === 'github')?.href ?? SITE.repo;
---

<BaseLayout title="项目" description="我做过的项目与整理过的笔记">
  <div class="container-wide pt-10 sm:pt-14">
    <header class="mb-10">
      <h1 class="text-2xl font-bold tracking-tight text-fg">项目</h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-fg-muted">{projectsData.intro}</p>
      {
        total > 0 && (
          <p class="mt-2 text-xs text-fg-subtle">
            共 {total} 个项目，分 {sections.length} 类
          </p>
        )
      }
    </header>

    {
      sections.length > 0 ? (
        <div class="space-y-12">
          {sections.map((section) => (
            <section>
              <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-border pb-2">
                <h2 class="flex items-center gap-2 text-[1.05rem] font-semibold tracking-tight text-fg">
                  <span class="inline-block h-4 w-1 rounded-full bg-accent" />
                  {section.title}
                </h2>
                <span class="shrink-0 text-xs tabular-nums text-fg-subtle">
                  {section.items.length} 个
                </span>
              </div>

              {section.description && (
                <p class="mb-4 text-sm text-fg-muted">{section.description}</p>
              )}

              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4">
                {section.items.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="card p-6 text-sm text-fg-muted">
          <p>还没有添加项目。</p>
          <p class="mt-2 text-fg-subtle">
            在 <code class="text-accent">src/data/projects.json</code> 的
            <code class="text-accent">sections</code> 里加内容就会显示在这里。
          </p>
        </div>
      )
    }

    <!-- 联系方式 -->
    <section class="card mt-12 flex flex-col items-start gap-3 p-5 sm:flex-row sm:items-center">
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-bg-muted text-fg-subtle"
      >
        <Icon name="mail" size={16} />
      </span>
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-fg">想聊聊某个项目？</p>
        <p class="mt-0.5 text-sm text-fg-muted">
          欢迎通过首页的联系方式找我，或者直接去 GitHub 提 issue。
        </p>
      </div>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        class="flex shrink-0 items-center gap-1.5 rounded-lg border border-border bg-bg-subtle px-3.5 py-2 text-sm text-fg transition-colors hover:border-border-strong"
      >
        <Icon name="github" size={14} />
        GitHub
      </a>
    </section>
  </div>
</BaseLayout>
