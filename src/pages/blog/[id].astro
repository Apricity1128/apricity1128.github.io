---
/**
 * 文章详情页 /blog/[id]
 *
 * 结构：标题区 → 正文 + 右侧目录 → 上一篇/下一篇
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import TagList from '../../components/TagList.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getSortedPosts, formatDate, toISODate, readingTime } from '../../utils/posts.js';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const { title, description, pubDate, updatedDate, tags } = post.data;

const posts = await getSortedPosts();
const index = posts.findIndex((p) => p.id === post.id);
const prev = index < posts.length - 1 ? posts[index + 1] : null; // 更旧
const next = index > 0 ? posts[index - 1] : null; // 更新

const minutes = readingTime(post.body ?? '');

// 构建期生成 JSON-LD，方便搜索引擎理解
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description || undefined,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Apricity' },
  keywords: tags.join(', '),
  inLanguage: 'zh-CN',
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
>
  <div class="container-wide pt-10 sm:pt-14">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_14rem] lg:gap-12">
      <!-- ============ 正文 ============ -->
      <!-- data-pagefind-body：告诉 Pagefind 只把正文当作可检索内容，
           标题区和目录属于界面元素，不参与索引 -->
      <article data-pagefind-body class="min-w-0">
        <!-- 标题区 -->
        <header data-pagefind-ignore class="mb-8 border-b border-border pb-6">
          <h1 class="text-balance text-[1.75rem] font-bold leading-[1.3] tracking-tight text-fg sm:text-[2rem]">
            {title}
          </h1>

          {
            description && (
              <p class="mt-3 text-[0.95rem] leading-relaxed text-fg-muted">{description}</p>
            )
          }

          <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-fg-subtle">
            <time datetime={toISODate(pubDate)} class="flex items-center gap-1.5">
              <Icon name="calendar" size={13} />
              {formatDate(pubDate)}
            </time>

            <span class="flex items-center gap-1.5">
              <Icon name="clock" size={13} />
              {minutes} 分钟阅读
            </span>

            {
              updatedDate && (
                <span class="flex items-center gap-1.5" title="最后更新">
                  <Icon name="edit" size={13} />
                  {formatDate(updatedDate)} 更新
                </span>
              )
            }
          </div>

          {tags.length > 0 && <div class="mt-4"><TagList tags={tags} /></div>}
        </header>

        <!-- 移动端目录 -->
        {
          headings.length > 0 && (
            <details class="card mb-8 p-4 lg:hidden">
              <summary class="cursor-pointer text-sm font-medium text-fg select-none">
                目录
              </summary>
              <div class="mt-3">
                <TableOfContents headings={headings} />
              </div>
            </details>
          )
        }

        <!-- 正文 -->
        <div class="prose-blog">
          <Content />
        </div>

        <!-- 上一篇 / 下一篇 -->
        <nav
          data-pagefind-ignore
          class="mt-14 grid grid-cols-1 gap-3 border-t border-border pt-6 sm:grid-cols-2"
        >
          {
            prev ? (
              <a href={`/blog/${prev.id}`} class="card card-hover group p-4">
                <span class="flex items-center gap-1.5 text-xs text-fg-subtle">
                  <Icon name="arrowLeft" size={12} />
                  上一篇
                </span>
                <span class="mt-1.5 block text-sm font-medium text-fg transition-colors group-hover:text-accent">
                  {prev.data.title}
                </span>
              </a>
            ) : (
              <span />
            )
          }

          {
            next && (
              <a href={`/blog/${next.id}`} class="card card-hover group p-4 sm:text-right">
                <span class="flex items-center gap-1.5 text-xs text-fg-subtle sm:justify-end">
                  下一篇
                  <Icon name="arrowRight" size={12} />
                </span>
                <span class="mt-1.5 block text-sm font-medium text-fg transition-colors group-hover:text-accent">
                  {next.data.title}
                </span>
              </a>
            )
          }
        </nav>

        <div class="mt-8">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 text-sm text-fg-muted transition-colors hover:text-accent"
          >
            <Icon name="arrowLeft" size={14} />
            返回文章列表
          </a>
        </div>
      </article>

      <!-- ============ 右侧目录（宽屏） ============ -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
