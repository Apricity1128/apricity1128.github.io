---
/**
 * 博客列表页 /blog
 * 按年份分组展示全部文章，支持标签筛选入口。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getSortedPosts, getTagCounts, tagToSlug } from '../../utils/posts.js';

const posts = await getSortedPosts();
const tags = await getTagCounts();

// 按年份分组
const byYear = new Map();
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year).push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout title="博客" description="全部文章列表">
  <div class="container-page pt-10 sm:pt-14">
    <!-- 标题 -->
    <header class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-fg">博客</h1>
      <p class="mt-1.5 text-sm text-fg-muted">
        共 {posts.length} 篇文章
        {tags.length > 0 && <span class="text-fg-subtle">，{tags.length} 个标签</span>}
      </p>
    </header>

    <!-- 标签入口 -->
    {
      tags.length > 0 && (
        <div class="mb-10">
          <div class="flex flex-wrap gap-1.5">
            {tags.map(({ tag, count }) => (
              <a href={`/tags/${tagToSlug(tag)}`} class="chip">
                {tag}
                <span class="text-fg-subtle">{count}</span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- 按年分组 -->
    {
      posts.length > 0 ? (
        <div class="space-y-10">
          {years.map((year) => (
            <section>
              <h2 class="mb-4 flex items-center gap-3 text-sm font-semibold text-fg-subtle">
                <span class="tabular-nums">{year}</span>
                <span class="h-px flex-1 bg-border" />
                <span class="tabular-nums font-normal">{byYear.get(year).length} 篇</span>
              </h2>
              <div class="space-y-3">
                {byYear.get(year).map((post) => (
                  <PostCard post={post} />
                ))}
              </div>
            </section>
          ))}
        </div>
      ) : (
        <div class="card p-8 text-center">
          <p class="text-fg-muted">还没有文章。</p>
          <p class="mt-2 text-sm text-fg-subtle">
            在 <code class="text-accent">src/content/blog/</code> 新建 .md 文件即可发布。
          </p>
        </div>
      )
    }

    <div class="mt-10">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-sm text-fg-muted transition-colors hover:text-accent"
      >
        <Icon name="arrowLeft" size={14} />
        返回首页
      </a>
    </div>
  </div>
</BaseLayout>
