---
/**
 * 标签页 /tags 和 /tags/[tag]
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import { getSortedPosts, getTagCounts, tagToSlug } from '../../utils/posts.js';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  const tags = new Set(posts.flatMap((p) => p.data.tags));

  return [...tags].map((tag) => ({
    params: { tag: tagToSlug(tag) },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
const allTags = await getTagCounts();
---

<BaseLayout title={`标签：${tag}`} description={`所有带有「${tag}」标签的文章`}>
  <div class="container-page pt-10 sm:pt-14">
    <header class="mb-8">
      <a
        href="/blog"
        class="mb-4 inline-flex items-center gap-1.5 text-sm text-fg-muted transition-colors hover:text-accent"
      >
        <Icon name="arrowLeft" size={14} />
        全部文章
      </a>
      <h1 class="flex items-center gap-2.5 text-2xl font-bold tracking-tight text-fg">
        <Icon name="tag" size={22} class="text-accent" />
        {tag}
      </h1>
      <p class="mt-1.5 text-sm text-fg-muted">{posts.length} 篇文章</p>
    </header>

    <div class="space-y-3">
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    <!-- 其他标签 -->
    {
      allTags.length > 1 && (
        <div class="mt-12 border-t border-border pt-6">
          <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-fg-subtle">
            其他标签
          </p>
          <div class="flex flex-wrap gap-1.5">
            {allTags
              .filter((t) => t.tag !== tag)
              .map(({ tag: other, count }) => (
                <a href={`/tags/${tagToSlug(other)}`} class="chip">
                  {other}
                  <span class="text-fg-subtle">{count}</span>
                </a>
              ))}
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
