---
/**
 * Footer —— 页脚
 */
import Icon from './Icon.astro';
import { SITE } from '../data/site.mjs';

const year = new Date().getFullYear();
const range = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
---

<footer data-pagefind-ignore class="mt-auto border-t border-border bg-bg-subtle/50">
  <div
    class="container-wide flex flex-col items-center justify-between gap-4 py-8 text-sm text-fg-muted sm:flex-row"
  >
    <p class="text-center sm:text-left">
      © {range} {SITE.author.name}
      <span class="mx-1.5 text-fg-subtle">·</span>
      <span class="text-fg-subtle">由 Astro 驱动</span>
    </p>

    <div class="flex items-center gap-1">
      {
        SITE.socials.map((item) => (
          <a
            href={item.href}
            target={item.href.startsWith('http') ? '_blank' : undefined}
            rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={item.label}
            title={item.label}
            class="flex h-8 w-8 items-center justify-center rounded-lg text-fg-subtle transition-colors hover:bg-bg-muted hover:text-fg"
          >
            <Icon name={item.icon} size={16} />
          </a>
        ))
      }
    </div>
  </div>
</footer>
