---
/**
 * TagList —— 标签胶囊列表
 */
import { tagToSlug } from '../utils/posts.js';

const {
  tags = [],
  /** 是否可点击跳转到标签页 */
  linkable = true,
  size = 'sm',
} = Astro.props;

const sizeClass = size === 'md' ? 'text-sm !px-3 !py-1' : '';
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) =>
      linkable ? (
        <a href={`/tags/${tagToSlug(tag)}`} class:list={['chip', sizeClass]}>
          {tag}
        </a>
      ) : (
        <span class:list={['chip', sizeClass]}>{tag}</span>
      )
    )
  }
</div>
