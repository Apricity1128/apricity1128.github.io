---
/**
 * ProjectCard —— 项目页的一张卡片
 *
 * 风格参考 Astro Theme Pure（arthals.ink 用的就是这个主题）的项目页：
 *   · 圆角边框容器，右侧可选一张渐隐的背景图
 *   · 项目名是可点的主链接，下面是两行描述
 *   · 底部一排圆形图标按钮，每个链接按类型显示不同图标
 */
import Icon from './Icon.astro';

const { project } = Astro.props;

const { name, description, tags = [], year = '', image = '', links = [] } = project;

/** 链接类型 → 图标 + 悬浮颜色 */
const LINK_TYPES = {
  repo: { icon: 'github', label: '源代码', color: 'var(--fg)' },
  site: { icon: 'globe', label: '在线访问', color: 'oklch(0.62 0.15 250)' },
  docs: { icon: 'document', label: '文档', color: 'oklch(0.68 0.14 65)' },
  release: { icon: 'package', label: '发布', color: 'oklch(0.62 0.15 150)' },
};

// 兼容旧写法：如果只给了 repo/href 字符串，就自动拼成 links 数组
const normalised = links.length
  ? links
  : [
      project.repo ? { type: 'repo', href: project.repo } : null,
      project.href && project.href !== project.repo ? { type: 'site', href: project.href } : null,
    ].filter(Boolean);

/** 卡片标题点击后跳到哪：优先在线站点，其次源码 */
const primaryHref =
  normalised.find((l) => l.type === 'site')?.href ??
  normalised[0]?.href ??
  project.href ??
  project.repo ??
  '';
---

<div class="card card-hover group relative overflow-hidden">
  {
    image && (
      <img
        src={image}
        alt=""
        loading="lazy"
        decoding="async"
        aria-hidden="true"
        class="pointer-events-none absolute inset-y-0 end-0 z-0 h-full w-1/2 object-cover opacity-30 transition-opacity duration-300 group-hover:opacity-40"
        style={{
          maskImage:
            'linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 100%)',
          WebkitMaskImage:
            'linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 100%)',
        }}
      />
    )
  }

  <div class:list={['relative z-10 flex flex-col gap-1.5 p-4', image && 'pe-20']}>
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="min-w-0 text-[0.95rem] font-semibold leading-snug tracking-tight">
        {
          primaryHref ? (
            <a
              href={primaryHref}
              target="_blank"
              rel="noopener noreferrer"
              class="text-fg transition-colors group-hover:text-accent"
            >
              {name}
            </a>
          ) : (
            <span class="text-fg">{name}</span>
          )
        }
      </h3>
      {year && <span class="shrink-0 text-xs tabular-nums text-fg-subtle">{year}</span>}
    </div>

    <p class="line-clamp-2 text-sm leading-relaxed text-fg-muted">{description}</p>

    {
      tags.length > 0 && (
        <div class="mt-0.5 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="chip">{tag}</span>
          ))}
        </div>
      )
    }

    {
      normalised.length > 0 && (
        <div class="mt-1 flex flex-row items-center gap-2">
          {normalised.map((link) => {
            const meta = LINK_TYPES[link.type] ?? LINK_TYPES.site;
            return (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${name} · ${meta.label}`}
                title={link.label ?? meta.label}
                class="project-link flex h-7 w-7 items-center justify-center rounded-full bg-bg-muted text-fg-subtle transition-colors"
                style={`--link-color:${meta.color}`}
              >
                <Icon name={meta.icon} size={14} />
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</div>

<style>
  /* 图标按钮悬浮时变成该链接类型的主题色 */
  .project-link:hover {
    color: var(--link-color);
    background-color: color-mix(in oklch, var(--link-color) 14%, transparent);
  }
</style>
