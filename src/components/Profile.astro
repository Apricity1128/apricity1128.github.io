---
/**
 * Profile —— 首页左侧的个人卡片
 * 头像 + 名字 + 位置 + 一句话简介 + 社交链接
 */
import Icon from './Icon.astro';
import { SITE } from '../data/site.mjs';

const { avatar = SITE.author.avatar, name = SITE.author.name } = SITE.author;
---

<div class="flex flex-col items-center text-center lg:items-start lg:text-left">
  <!-- 头像 -->
  <div class="relative">
    <div
      class="absolute inset-0 rounded-full bg-accent/25 blur-2xl"
      aria-hidden="true"
      style="transform: scale(0.9)"
    >
    </div>
    <img
      src={avatar}
      alt={`${name} 的头像`}
      width="112"
      height="112"
      loading="eager"
      decoding="async"
      class="relative h-24 w-24 rounded-full border border-border bg-bg-subtle object-cover sm:h-28 sm:w-28"
    />
  </div>

  <!-- 名字 -->
  <h1 class="mt-5 text-2xl font-bold tracking-tight text-fg">{name}</h1>

  <!-- 标签行：位置 + 身份 -->
  <p class="mt-1.5 flex items-center gap-2 text-sm text-fg-muted">
    <span>{SITE.author.location}</span>
    <span class="text-fg-subtle">/</span>
    <span>{SITE.author.bio}</span>
  </p>

  <!-- 社交链接 -->
  <div class="mt-5 flex items-center gap-2">
    {
      SITE.socials.map((item) => (
        <a
          href={item.href}
          target={item.href.startsWith('http') ? '_blank' : undefined}
          rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="flex items-center gap-1.5 rounded-lg border border-border bg-bg-subtle px-2.5 py-1.5 text-xs text-fg-muted transition-colors hover:border-border-strong hover:text-fg"
          title={item.label}
        >
          <Icon name={item.icon} size={14} />
          <span class="hidden sm:inline">{item.label}</span>
        </a>
      ))
    }
  </div>
</div>
